{
  "name": "family-portfolio",
  "productName": "Family Portfolio",
  "version": "0.9.0",
  "description": "Local desktop tracker for family investments (stocks, MFs, US stocks, EPF, NPS, insurance)",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "dist": "npm run build && node tools/smoke/ui-smoke.mjs && electron-builder --win",
    "format": "prettier --write .",
    "smoke": "electron-vite build && node tools/smoke/ui-smoke.mjs"
  },
  "dependencies": {
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@13.0.3",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@fontsource-variable/anek-latin": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-chart-matrix": "^2.1.1",
    "chartjs-chart-treemap": "^3.1.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
